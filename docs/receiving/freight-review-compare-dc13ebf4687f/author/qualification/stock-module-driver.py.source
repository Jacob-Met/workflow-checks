import base64,hashlib,json,os,subprocess,sys
from pathlib import Path
inputs=json.loads("{\"A\":\"\",\"B\":\"\"}")
root=Path("/dev/shm/freight-review-compare-dc13ebf4687f")
source=root/"candidate"/"freight_packets"
case=root/"receiving-tmp"/"module-entry"
case.mkdir()
paths={name:case/(name+".zip") for name in inputs}
for name,path in paths.items():
    with path.open("xb") as stream:stream.write(base64.b64decode(inputs[name]))
output=case/"comparison.html"
def image(path):
    stat=path.stat();return {"bytes":stat.st_size,"sha256":hashlib.sha256(path.read_bytes()).hexdigest(),"inode":stat.st_ino,"mtime_ns":stat.st_mtime_ns}
source_files=[p for p in (root/"candidate").rglob("*") if p.is_file()]
before_source={str(p.relative_to(root)):image(p)["sha256"] for p in source_files}
before_inputs={name:image(path) for name,path in paths.items()}
env=dict(os.environ);env["PYTHONPATH"]=str(source);env["PYTHONDONTWRITEBYTECODE"]="1"
command=[sys.executable,"-B","-S","-m","freightpkt.review_compare",str(paths["A"]),str(paths["B"]),"--out",str(output)]
result=subprocess.run(command,cwd="/tmp",env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=20)
after_inputs={name:image(path) for name,path in paths.items()}
after_source={str(p.relative_to(root)):image(p)["sha256"] for p in source_files}
report=output.read_bytes() if output.exists() else b""
checks={"exit_zero":result.returncode==0,"stderr_empty":result.stderr=="","complete_document":report.startswith(b"<!doctype html>") and report.endswith(b"</body></html>\n"),"exact_old_departure":b"12:30:00-05:00" in report,"exact_new_departure":b"14:00:00-05:00" in report,"original_source_pointer":b"tracking.csv:row7" in report,"recorded_stale_state":b"&quot;stale&quot;" in report,"no_current_approval_inference":b"establishes no current approval" in report,"inputs_unchanged":before_inputs==after_inputs,"all_six_source_files_unchanged":before_source==after_source}
receipt={"status":"pass" if all(checks.values()) else "fail","command":command,"cwd":"/tmp","python":sys.version,"returncode":result.returncode,"stdout":result.stdout,"stderr":result.stderr,"checks":checks,"source_before":before_source,"source_after":after_source,"inputs_before":before_inputs,"inputs_after":after_inputs,"output":{"path":str(output),**image(output)} if output.exists() else None,"limits":["One actual stock python -m invocation using a sparse exact receiving tree and authored native ZIP bytes.","No GUI, app/server/source pipeline or live operational state.","Source lookup uses only the explicit receiving PYTHONPATH; no installation or deployment claim."]}
text=json.dumps(receipt,sort_keys=True,indent=2)+"\n"
with (case/"receipt.json").open("x",encoding="utf-8") as stream:stream.write(text)
print(text,end="")
raise SystemExit(0 if receipt["status"]=="pass" else 1)
