import base64, collections, copy, hashlib, io, json, sys, types, zipfile
payload = json.loads("{\"source\":\"\\\"\\\"\\\"Portable, read-only handoff for one generated freight packet and saved review.\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport hashlib\\nimport io\\nimport json\\nimport re\\nimport zipfile\\nfrom html import escape\\n\\n\\ndef _json_bytes(value) -> bytes:\\n    # Escaped JSON preserves every saved string, including a legacy surrogate.\\n    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True,\\n                       allow_nan=False) + \\\"\\\\n\\\").encode(\\\"utf-8\\\")\\n\\n\\ndef review_version(review) -> str:\\n    \\\"\\\"\\\"Identity of the exact displayed native decision view, including history.\\\"\\\"\\\"\\n    encoded = json.dumps(review, sort_keys=True, separators=(\\\",\\\", \\\":\\\"),\\n                         ensure_ascii=True, allow_nan=False).encode(\\\"utf-8\\\")\\n    return hashlib.sha256(encoded).hexdigest()\\n\\n\\ndef bundle_filename(load_id: str, evidence_version: str) -> str:\\n    label = re.sub(r\\\"[^A-Za-z0-9_-]+\\\", \\\"-\\\", load_id).strip(\\\"-\\\")[:64] or \\\"load\\\"\\n    return f\\\"freight-review-{label}-{evidence_version[:12]}.zip\\\"\\n\\n\\ndef _text(value) -> str:\\n    text = str(value if value is not None else \\\"\\\").encode(\\\"utf-8\\\", errors=\\\"backslashreplace\\\").decode(\\\"utf-8\\\")\\n    return escape(text, quote=True)\\n\\n\\ndef _review_heading(review) -> str:\\n    if review is None:\\n        return \\\"Not reviewed\\\"\\n    state = review.get(\\\"review_state\\\")\\n    if state == \\\"cleared\\\":\\n        return \\\"Saved review cleared\\\"\\n    if state == \\\"current\\\" and review.get(\\\"decision\\\") in {\\\"approve\\\", \\\"adjust\\\", \\\"reject\\\"}:\\n        return \\\"Current saved review: \\\" + {\\\"approve\\\": \\\"Approve\\\", \\\"adjust\\\": \\\"Needs adjust\\\",\\n                                          \\\"reject\\\": \\\"Reject\\\"}[review[\\\"decision\\\"]]\\n    return {\\\"stale\\\": \\\"Previous review — review again\\\",\\n            \\\"unbound\\\": \\\"Previous review has no evidence binding — review again\\\",\\n            \\\"missing\\\": \\\"Previous review has no readable packet\\\"}.get(\\n                state, \\\"Unrecognized saved review — review again\\\")\\n\\n\\ndef _cover(load_id, evidence_version, saved_version, evidence, review) -> bytes:\\n    history = review.get(\\\"history\\\", []) if review else []\\n    if not isinstance(history, list) or any(not isinstance(row, dict) for row in history):\\n        raise ValueError(\\\"saved review history is not a list of review records\\\")\\n    details = \\\"\\\"\\n    if review:\\n        details = (f\\\"<p>Recorded decision: <strong>{_text(review.get('decision'))}</strong>\\\"\\n                   f\\\"<br>Recorded at: {_text(review.get('at'))}</p>\\\"\\n                   f\\\"<h3>Saved note</h3><p class=\\\\\\\"note\\\\\\\">{_text(review.get('note')) or 'No saved note.'}</p>\\\")\\n    previous = \\\"\\\".join(\\n        f\\\"<li><strong>{_text(row.get('decision'))}</strong> · {_text(row.get('at'))}\\\"\\n        f\\\"<p class=\\\\\\\"note\\\\\\\">{_text(row.get('note'))}</p>\\\"\\n        f\\\"<small>Recorded evidence: {_text(row.get('evidence_version')) or 'Not recorded'}</small></li>\\\"\\n        for row in reversed(history))\\n    section_counts = \\\"\\\".join(f\\\"<li>{_text(name)}: {len(rows)} selected-load record(s)</li>\\\"\\n                             for name, rows in evidence.items() if isinstance(rows, list))\\n    html = f\\\"\\\"\\\"<!doctype html>\\n<html lang=\\\"en\\\"><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>Freight review handoff — {_text(load_id)}</title>\\n<style>\\nbody{{font:16px/1.5 system-ui,sans-serif;max-width:850px;margin:2rem auto;padding:0 1rem;color:#1b1f24}}\\nh1{{font-size:1.7rem}}h2{{font-size:1.25rem}}.draft{{background:#fff4ce;border:1px solid #d8a800;padding:1rem}}\\n.note{{white-space:pre-wrap;overflow-wrap:anywhere}}code,small{{overflow-wrap:anywhere}}li{{margin:.6rem 0}}\\n@media print{{body{{margin:0}}a{{color:inherit}}}}\\n</style>\\n<h1>Freight review handoff</h1><h2>Load {_text(load_id)}</h2>\\n<p class=\\\"draft\\\"><strong>Draft review.</strong> Nothing is sent, filed, invoiced or paid.\\nA reviewer decision is not a payment instruction.</p>\\n<h2>{_text(_review_heading(review))}</h2>\\n{details}\\n<p>The saved review and its history below are copied from the local review record.\\nAn earlier or unbound review does not become approval of this packet.</p>\\n<h2>Open the evidence</h2>\\n<ul><li><a href=\\\"packet.html\\\">Original generated packet</a></li>\\n<li><a href=\\\"evidence.json\\\">Selected-load report records and original source references</a></li>\\n<li><a href=\\\"review.json\\\">Exact saved review and history</a></li>\\n<li><a href=\\\"manifest.json\\\">File sizes and SHA-256 checksums</a></li></ul>\\n<ul>{section_counts}</ul>\\n<details><summary>Snapshot identity</summary>\\n<p>Packet/report evidence: <code>{_text(evidence_version)}</code><br>\\nSaved review: <code>{_text(saved_version)}</code></p></details>\\n<h2>Previous saved reviews ({len(history)})</h2>\\n{('<ol>' + previous + '</ol>') if previous else '<p>No previous reviews are recorded.</p>'}\\n<p>Only this load is included. Original input files, other-load reports and the global audit log\\nare not included; the original file:row references remain in the copied evidence.</p>\\n<p>This is a snapshot. Later changes in the review app do not update this file.</p>\\n</html>\\n\\\"\\\"\\\"\\n    # A legacy surrogate is exact in JSON and visible as a backslash escape in HTML.\\n    return html.encode(\\\"utf-8\\\")\\n\\n\\ndef build_bundle(load_id: str, packet: bytes, evidence: dict, saved_review,\\n                 evidence_version: str, saved_version: str) -> bytes:\\n    \\\"\\\"\\\"Serialize an already fenced snapshot without reading or writing source files.\\\"\\\"\\\"\\n    canonical = json.dumps(evidence, sort_keys=True, separators=(\\\",\\\", \\\":\\\"),\\n                           ensure_ascii=False, allow_nan=False).encode(\\\"utf-8\\\")\\n    if hashlib.sha256(canonical).hexdigest() != evidence_version:\\n        raise ValueError(\\\"packet/report snapshot does not match its evidence version\\\")\\n    if evidence.get(\\\"packet_sha256\\\") != hashlib.sha256(packet).hexdigest():\\n        raise ValueError(\\\"packet bytes do not match the selected evidence\\\")\\n    if review_version(saved_review) != saved_version:\\n        raise ValueError(\\\"saved review does not match its version\\\")\\n    members = {\\n        \\\"index.html\\\": _cover(load_id, evidence_version, saved_version, evidence, saved_review),\\n        \\\"packet.html\\\": packet,\\n        \\\"evidence.json\\\": _json_bytes(evidence),\\n        \\\"review.json\\\": _json_bytes({\\\"schema\\\": \\\"freight-review-snapshot.v1\\\", \\\"load_id\\\": load_id,\\n                                   \\\"evidence_version\\\": evidence_version, \\\"review_version\\\": saved_version,\\n                                   \\\"review\\\": saved_review}),\\n    }\\n    members[\\\"manifest.json\\\"] = _json_bytes({\\n        \\\"schema\\\": \\\"freight-review-bundle.v1\\\", \\\"load_id\\\": load_id,\\n        \\\"evidence_version\\\": evidence_version, \\\"review_version\\\": saved_version,\\n        \\\"files\\\": [{\\\"path\\\": name, \\\"bytes\\\": len(data), \\\"sha256\\\": hashlib.sha256(data).hexdigest()}\\n                  for name, data in members.items()],\\n    })\\n    result = io.BytesIO()\\n    with zipfile.ZipFile(result, \\\"w\\\") as archive:\\n        for name, data in members.items():\\n            item = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))\\n            item.compress_type = zipfile.ZIP_DEFLATED\\n            item.external_attr = 0o100644 << 16\\n            archive.writestr(item, data)\\n    return result.getvalue()\\n\\n\",\"contract\":{\"version\":1,\"status\":\"preimplementation oracle; product not edited\",\"repository\":\"Jacob-Met/workflow-checks\",\"baseline\":{\"head\":\"125339ec63eeb7c4989c9b240c01202555dce573\",\"tree\":\"e3a3501d60ee8f301f9d45ea15d0d324b814e59a\"},\"original_before\":{\"bytes\":20565,\"sha256\":\"a6f488b791a13b023448c58c7a5c318fc030b70c7860ec91bc033b86bfa2e352\",\"git_blob\":\"4f95b9e7366358a92ce9d14162c0a2f8a8010523\"},\"selection\":{\"sides\":\"Supplied Copy A and Copy B, with no inferred chronology or current approval\",\"same_load\":\"Require exact same nonempty string load ID; differing IDs refuse before output creation\",\"input_contract\":\"Exact five unique native v1 ZIP members, content-bound by the existing manifest, evidence digest, packet digest and review digest\",\"row_contract\":\"Exact canonical native JSON record identity, preserving multiplicity and JSON distinctions such as false versus zero\",\"output_contract\":\"Complete self-contained HTML created exclusively only after both inputs validate and report rendering finishes; supplied packet/index HTML never executed or injected; no source reprocessing or review action\"},\"decisive_cases\":[{\"name\":\"same-copy\",\"expect\":\"All six sections have zero A-only/B-only records; identical evidence/review/packet identities; no inferred later copy\"},{\"name\":\"departure-and-stale-review\",\"expect\":\"One A-only old stop and one B-only new stop retain tracking.csv:row7, copied old approval stays recorded stale in B, packet digest changes\"},{\"name\":\"multiplicity\",\"expect\":\"Three identical stop records in A and one in B produce two A-only occurrences and one unchanged occurrence; another identical literal stop stays unchanged\"},{\"name\":\"typed-literal-values\",\"expect\":\"Exact records containing amount 0, false and null remain three distinct unchanged records; nested unknown fields, markup, Unicode, newline, note/history and surrogate text are preserved as escaped data\"},{\"name\":\"refusals\",\"expect\":\"Malformed member/schema/digest/selected-load or mismatched load refuses before output; existing output file remains untouched\"}],\"source_fence\":{\"new\":[\"freight_packets/freightpkt/review_compare.py\",\"freight_packets/tests/test_review_compare.py\",\"freight_packets/REVIEW_COMPARE.md\"],\"additive\":[\"freight_packets/README.md\"],\"preserved\":[\"freight_packets/freightpkt/handoff.py\",\"freight_packets/freightpkt/web.py\",\"freight_packets/freightpkt/ui.html\",\"freight_packets/freightpkt/cli.py\",\"freight_packets/freightpkt/pipeline.py\",\"all detention/invoice/fines/settlement/decision semantics\",\".github/workflows/tests.yml\"]}}}")
attempts=[]
def audit(event,args):
    if event=="open":
        mode=args[1]; flags=args[2]
        if (isinstance(mode,str) and any(c in mode for c in "wax+")) or (isinstance(flags,int) and flags & (1|2|64|512|1024)):
            attempts.append(event); raise RuntimeError("authored oracle forbids writes")
    if event in ("socket.connect","socket.bind","subprocess.Popen","os.system"):
        attempts.append(event); raise RuntimeError("authored oracle forbids external actions")
sys.addaudithook(audit)
m=types.ModuleType("unchanged_native_handoff")
exec(compile(payload["source"],"<pinned handoff bdcb6350>","exec"),m.__dict__)
sections=("stops","flags","fines","settlements","exceptions","packets")
lid="SYN-REVIEW-MULTIPLICITY"
packet=b'<!doctype html><script>globalThis.PACKET_MUST_NOT_RUN=true</script><p>Authored only</p>'
def canonical(v): return json.dumps(v,sort_keys=True,separators=(",",":"),ensure_ascii=False,allow_nan=False)
duplicate={"load_id":lid,"stop":1,"departure":"2026-10-01T12:30:00-05:00","evidence":["tracking.csv:row7"]}
literal={"load_id":lid,"stop":"Warehouse \\u0394 <North>","departure":None,"evidence":["tracking.csv:row8"],"extension":{"text":'caf\\u00e9 \\u65e5\\u672c\\u8a9e <script>alert("literal")</script> & \\nline two',"nullable":None,"false_value":False,"zero":0}}
literal=json.loads(json.dumps(literal).replace("\\\\u","\\u"))
rows=[{"load_id":lid,"amount":v,"source":"invoice.csv:row4"} for v in (0,False,None)]
a={"schema":"freight-review.v1","packet_sha256":hashlib.sha256(packet).hexdigest(),**{s:[] for s in sections}}
a["stops"]=sorted([copy.deepcopy(duplicate) for _ in range(3)]+[copy.deepcopy(literal)],key=canonical)
a["flags"]=sorted(rows,key=canonical)
a["packets"]=[{"load_id":lid,"file":"packets/kept-native-name.html","detention_cents":0}]
b=copy.deepcopy(a); b["stops"]=sorted([copy.deepcopy(duplicate),copy.deepcopy(literal)],key=canonical)
ev_a=hashlib.sha256(canonical(a).encode()).hexdigest()
review={"decision":"approve","note":'SYNTHETIC caf\\u00e9 <img src=x onerror="literal"> '+chr(0xD800),"at":"2026-10-02T09:00:00Z","evidence_version":ev_a,"review_state":"current","history":[{"decision":"adjust","note":"line1\\nline2 & \\"quoted\\"","evidence_version":None,"at":"2026-10-01T09:00:00Z"}]}
review["note"]=review["note"].replace("\\u00e9","\u00e9")
cases={}
for label,evidence,state in (("A",a,"current"),("B",b,"stale")):
    saved=copy.deepcopy(review); saved["review_state"]=state
    ev=hashlib.sha256(canonical(evidence).encode()).hexdigest()
    rv=m.review_version(saved)
    raw=m.build_bundle(lid,packet,evidence,saved,ev,rv)
    with zipfile.ZipFile(io.BytesIO(raw)) as z:
        assert len(z.infolist())==5
        files={x.filename:z.read(x) for x in z.infolist()}
    assert json.loads(files["evidence.json"])==evidence
    assert json.loads(files["review.json"])["review"]==saved
    manifest=json.loads(files["manifest.json"])
    assert all(row["bytes"]==len(files[row["path"]]) and row["sha256"]==hashlib.sha256(files[row["path"]]).hexdigest() for row in manifest["files"])
    cases[label]={"zip_base64":base64.b64encode(raw).decode(),"zip_bytes":len(raw),"zip_sha256":hashlib.sha256(raw).hexdigest(),"evidence":evidence,"review":saved,"manifest":manifest}
ca=collections.Counter(map(canonical,a["stops"])); cb=collections.Counter(map(canonical,b["stops"]))
assert sum((ca-cb).values())==2 and sum((cb-ca).values())==0 and sum((ca&cb).values())==2
assert len(set(map(canonical,a["flags"])))==3
assert len({row["amount"] for row in a["flags"]})==2  # Native Python equality is insufficient for the contract.
assert a["flags"]==b["flags"] and a["packet_sha256"]==b["packet_sha256"]
result={"status":"native producer preimplementation oracle frozen","source_git_blob":"bdcb63507b57d07eed1a6598d7d37d5f5d9db802","source_sha256":hashlib.sha256(payload["source"].encode()).hexdigest(),"contract":payload["contract"],"calls":{"unchanged_build_bundle":2,"candidate":0},"cases":cases,"observed":{"stops":{"A":4,"B":2,"only_A":2,"only_B":0,"unchanged":2},"flags":{"canonical_distinct":3,"python_value_set_distinct":2},"packet_digest_changed":False,"review_A":"current","review_B":"stale"},"blocked_attempts":attempts,"limits":["No product implementation or GUI was exercised.","No output writer or source pipeline was invoked.","Original 20565-byte before receipt preserved separately."]}
assert attempts==[]
print(json.dumps(result,ensure_ascii=True,sort_keys=True,indent=2)+"\n",end="")
