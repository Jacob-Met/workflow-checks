import base64, contextlib, copy, hashlib, io, json, sys, types, zipfile
from html.parser import HTMLParser
source=json.loads("{\"parent\":{\"head\":\"125339ec63eeb7c4989c9b240c01202555dce573\",\"tree\":\"e3a3501d60ee8f301f9d45ea15d0d324b814e59a\"},\"files\":{\"freight_packets/freightpkt/handoff.py\":{\"source\":\"\\\"\\\"\\\"Portable, read-only handoff for one generated freight packet and saved review.\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport hashlib\\nimport io\\nimport json\\nimport re\\nimport zipfile\\nfrom html import escape\\n\\n\\ndef _json_bytes(value) -> bytes:\\n    # Escaped JSON preserves every saved string, including a legacy surrogate.\\n    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True,\\n                       allow_nan=False) + \\\"\\\\n\\\").encode(\\\"utf-8\\\")\\n\\n\\ndef review_version(review) -> str:\\n    \\\"\\\"\\\"Identity of the exact displayed native decision view, including history.\\\"\\\"\\\"\\n    encoded = json.dumps(review, sort_keys=True, separators=(\\\",\\\", \\\":\\\"),\\n                         ensure_ascii=True, allow_nan=False).encode(\\\"utf-8\\\")\\n    return hashlib.sha256(encoded).hexdigest()\\n\\n\\ndef bundle_filename(load_id: str, evidence_version: str) -> str:\\n    label = re.sub(r\\\"[^A-Za-z0-9_-]+\\\", \\\"-\\\", load_id).strip(\\\"-\\\")[:64] or \\\"load\\\"\\n    return f\\\"freight-review-{label}-{evidence_version[:12]}.zip\\\"\\n\\n\\ndef _text(value) -> str:\\n    text = str(value if value is not None else \\\"\\\").encode(\\\"utf-8\\\", errors=\\\"backslashreplace\\\").decode(\\\"utf-8\\\")\\n    return escape(text, quote=True)\\n\\n\\ndef _review_heading(review) -> str:\\n    if review is None:\\n        return \\\"Not reviewed\\\"\\n    state = review.get(\\\"review_state\\\")\\n    if state == \\\"cleared\\\":\\n        return \\\"Saved review cleared\\\"\\n    if state == \\\"current\\\" and review.get(\\\"decision\\\") in {\\\"approve\\\", \\\"adjust\\\", \\\"reject\\\"}:\\n        return \\\"Current saved review: \\\" + {\\\"approve\\\": \\\"Approve\\\", \\\"adjust\\\": \\\"Needs adjust\\\",\\n                                          \\\"reject\\\": \\\"Reject\\\"}[review[\\\"decision\\\"]]\\n    return {\\\"stale\\\": \\\"Previous review — review again\\\",\\n            \\\"unbound\\\": \\\"Previous review has no evidence binding — review again\\\",\\n            \\\"missing\\\": \\\"Previous review has no readable packet\\\"}.get(\\n                state, \\\"Unrecognized saved review — review again\\\")\\n\\n\\ndef _cover(load_id, evidence_version, saved_version, evidence, review) -> bytes:\\n    history = review.get(\\\"history\\\", []) if review else []\\n    if not isinstance(history, list) or any(not isinstance(row, dict) for row in history):\\n        raise ValueError(\\\"saved review history is not a list of review records\\\")\\n    details = \\\"\\\"\\n    if review:\\n        details = (f\\\"<p>Recorded decision: <strong>{_text(review.get('decision'))}</strong>\\\"\\n                   f\\\"<br>Recorded at: {_text(review.get('at'))}</p>\\\"\\n                   f\\\"<h3>Saved note</h3><p class=\\\\\\\"note\\\\\\\">{_text(review.get('note')) or 'No saved note.'}</p>\\\")\\n    previous = \\\"\\\".join(\\n        f\\\"<li><strong>{_text(row.get('decision'))}</strong> · {_text(row.get('at'))}\\\"\\n        f\\\"<p class=\\\\\\\"note\\\\\\\">{_text(row.get('note'))}</p>\\\"\\n        f\\\"<small>Recorded evidence: {_text(row.get('evidence_version')) or 'Not recorded'}</small></li>\\\"\\n        for row in reversed(history))\\n    section_counts = \\\"\\\".join(f\\\"<li>{_text(name)}: {len(rows)} selected-load record(s)</li>\\\"\\n                             for name, rows in evidence.items() if isinstance(rows, list))\\n    html = f\\\"\\\"\\\"<!doctype html>\\n<html lang=\\\"en\\\"><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>Freight review handoff — {_text(load_id)}</title>\\n<style>\\nbody{{font:16px/1.5 system-ui,sans-serif;max-width:850px;margin:2rem auto;padding:0 1rem;color:#1b1f24}}\\nh1{{font-size:1.7rem}}h2{{font-size:1.25rem}}.draft{{background:#fff4ce;border:1px solid #d8a800;padding:1rem}}\\n.note{{white-space:pre-wrap;overflow-wrap:anywhere}}code,small{{overflow-wrap:anywhere}}li{{margin:.6rem 0}}\\n@media print{{body{{margin:0}}a{{color:inherit}}}}\\n</style>\\n<h1>Freight review handoff</h1><h2>Load {_text(load_id)}</h2>\\n<p class=\\\"draft\\\"><strong>Draft review.</strong> Nothing is sent, filed, invoiced or paid.\\nA reviewer decision is not a payment instruction.</p>\\n<h2>{_text(_review_heading(review))}</h2>\\n{details}\\n<p>The saved review and its history below are copied from the local review record.\\nAn earlier or unbound review does not become approval of this packet.</p>\\n<h2>Open the evidence</h2>\\n<ul><li><a href=\\\"packet.html\\\">Original generated packet</a></li>\\n<li><a href=\\\"evidence.json\\\">Selected-load report records and original source references</a></li>\\n<li><a href=\\\"review.json\\\">Exact saved review and history</a></li>\\n<li><a href=\\\"manifest.json\\\">File sizes and SHA-256 checksums</a></li></ul>\\n<ul>{section_counts}</ul>\\n<details><summary>Snapshot identity</summary>\\n<p>Packet/report evidence: <code>{_text(evidence_version)}</code><br>\\nSaved review: <code>{_text(saved_version)}</code></p></details>\\n<h2>Previous saved reviews ({len(history)})</h2>\\n{('<ol>' + previous + '</ol>') if previous else '<p>No previous reviews are recorded.</p>'}\\n<p>Only this load is included. Original input files, other-load reports and the global audit log\\nare not included; the original file:row references remain in the copied evidence.</p>\\n<p>This is a snapshot. Later changes in the review app do not update this file.</p>\\n</html>\\n\\\"\\\"\\\"\\n    # A legacy surrogate is exact in JSON and visible as a backslash escape in HTML.\\n    return html.encode(\\\"utf-8\\\")\\n\\n\\ndef build_bundle(load_id: str, packet: bytes, evidence: dict, saved_review,\\n                 evidence_version: str, saved_version: str) -> bytes:\\n    \\\"\\\"\\\"Serialize an already fenced snapshot without reading or writing source files.\\\"\\\"\\\"\\n    canonical = json.dumps(evidence, sort_keys=True, separators=(\\\",\\\", \\\":\\\"),\\n                           ensure_ascii=False, allow_nan=False).encode(\\\"utf-8\\\")\\n    if hashlib.sha256(canonical).hexdigest() != evidence_version:\\n        raise ValueError(\\\"packet/report snapshot does not match its evidence version\\\")\\n    if evidence.get(\\\"packet_sha256\\\") != hashlib.sha256(packet).hexdigest():\\n        raise ValueError(\\\"packet bytes do not match the selected evidence\\\")\\n    if review_version(saved_review) != saved_version:\\n        raise ValueError(\\\"saved review does not match its version\\\")\\n    members = {\\n        \\\"index.html\\\": _cover(load_id, evidence_version, saved_version, evidence, saved_review),\\n        \\\"packet.html\\\": packet,\\n        \\\"evidence.json\\\": _json_bytes(evidence),\\n        \\\"review.json\\\": _json_bytes({\\\"schema\\\": \\\"freight-review-snapshot.v1\\\", \\\"load_id\\\": load_id,\\n                                   \\\"evidence_version\\\": evidence_version, \\\"review_version\\\": saved_version,\\n                                   \\\"review\\\": saved_review}),\\n    }\\n    members[\\\"manifest.json\\\"] = _json_bytes({\\n        \\\"schema\\\": \\\"freight-review-bundle.v1\\\", \\\"load_id\\\": load_id,\\n        \\\"evidence_version\\\": evidence_version, \\\"review_version\\\": saved_version,\\n        \\\"files\\\": [{\\\"path\\\": name, \\\"bytes\\\": len(data), \\\"sha256\\\": hashlib.sha256(data).hexdigest()}\\n                  for name, data in members.items()],\\n    })\\n    result = io.BytesIO()\\n    with zipfile.ZipFile(result, \\\"w\\\") as archive:\\n        for name, data in members.items():\\n            item = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))\\n            item.compress_type = zipfile.ZIP_DEFLATED\\n            item.external_attr = 0o100644 << 16\\n            archive.writestr(item, data)\\n    return result.getvalue()\\n\\n\",\"git_blob\":\"bdcb63507b57d07eed1a6598d7d37d5f5d9db802\"},\"freight_packets/freightpkt/cli.py\":{\"source\":\"\\\"\\\"\\\"CLI: python -m freightpkt <generate|run|pdf|serve> ...\\\"\\\"\\\"\\r\\nfrom __future__ import annotations\\r\\n\\r\\nimport argparse\\r\\nimport sys\\r\\nfrom pathlib import Path\\r\\n\\r\\n\\r\\ndef main(argv=None) -> int:\\r\\n    ap = argparse.ArgumentParser(prog=\\\"freightpkt\\\", description=\\\"Detention/chargeback packet builder (PoC)\\\")\\r\\n    sub = ap.add_subparsers(dest=\\\"cmd\\\", required=True)\\r\\n\\r\\n    g = sub.add_parser(\\\"generate\\\", help=\\\"write synthetic sample data\\\")\\r\\n    g.add_argument(\\\"--out\\\", default=\\\"sample_data\\\")\\r\\n    g.add_argument(\\\"--loads\\\", type=int, default=24)\\r\\n    g.add_argument(\\\"--seed\\\", type=int, default=7)\\r\\n\\r\\n    r = sub.add_parser(\\\"run\\\", help=\\\"process a data dir into packets + reports\\\")\\r\\n    r.add_argument(\\\"--data\\\", default=\\\"sample_data\\\")\\r\\n    r.add_argument(\\\"--out\\\", default=\\\"out\\\")\\r\\n    r.add_argument(\\\"--pdf\\\", action=\\\"store_true\\\", help=\\\"also render packets to PDF via local Edge/Chrome\\\")\\r\\n\\r\\n    s = sub.add_parser(\\\"serve\\\", help=\\\"local review UI on 127.0.0.1\\\")\\r\\n    s.add_argument(\\\"--data\\\", default=\\\"sample_data\\\")\\r\\n    s.add_argument(\\\"--out\\\", default=\\\"out\\\")\\r\\n    s.add_argument(\\\"--port\\\", type=int, default=8765)\\r\\n\\r\\n    a = ap.parse_args(argv)\\r\\n    if a.cmd == \\\"generate\\\":\\r\\n        from .synth import generate\\r\\n        exp = generate(Path(a.out), a.loads, a.seed)\\r\\n        print(f\\\"wrote synthetic data to {a.out}: {a.loads} loads, \\\"\\r\\n              f\\\"{len(exp['invoice_defects'])} seeded invoice defects, \\\"\\r\\n              f\\\"expected detention ${exp['detention_total_cents'] / 100:,.2f}\\\")\\r\\n        return 0\\r\\n    if a.cmd == \\\"run\\\":\\r\\n        from .pipeline import run\\r\\n        from .models import money\\r\\n        s = run(Path(a.data), Path(a.out))\\r\\n        c = s[\\\"counts\\\"]\\r\\n        print(f\\\"events={c['events']} loads={c['loads']} stops={c['stops']}\\\")\\r\\n        print(f\\\"detention stops={c['detention_stops']}  total={s['detention_total']}  \\\"\\r\\n              f\\\"late arrivals={c['late_arrivals']}  exceptions={c['exceptions']}\\\")\\r\\n        print(f\\\"invoice flags={c['invoice_flags']}  packets={c['packets']}  -> {a.out}\\\")\\r\\n        for f in s[\\\"flags\\\"]:\\r\\n            print(f\\\"  [{f['code']}] {f['load_id']} inv {f['invoice_no']}: {f['detail']}\\\")\\r\\n        if a.pdf:\\r\\n            from .pdf import html_to_pdf\\r\\n            ok = 0\\r\\n            for p in s[\\\"packets\\\"]:\\r\\n                html = Path(a.out) / p[\\\"file\\\"]\\r\\n                ok += html_to_pdf(html, html.with_suffix(\\\".pdf\\\"))\\r\\n            print(f\\\"PDF: {ok}/{len(s['packets'])} rendered\\\" + (\\\"\\\" if ok else \\\" (no Edge/Chrome found; HTML kept)\\\"))\\r\\n        return 0\\r\\n    if a.cmd == \\\"serve\\\":\\r\\n        from .web import serve\\r\\n        serve(Path(a.data), Path(a.out), a.port)\\r\\n        return 0\\r\\n    return 1\\r\\n\\r\\n\\r\\nif __name__ == \\\"__main__\\\":\\r\\n    sys.exit(main())\\r\\n\",\"git_blob\":\"a64a4d60816654595b1767ff9f96cd2cd9c49c32\"}},\"scope\":\"Read-only native serializer and existing CLI admission; no product implementation or live data.\"}")
def pin(raw):
 return {'size':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'git_blob':hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()}
for name,item in source['files'].items():
 if pin(item['source'].encode())['git_blob']!=item['git_blob']: raise RuntimeError('Source pin mismatch: '+name)
blocked=[]
def audit(event,args):
 if event in ('socket.connect','subprocess.Popen','os.system','os.posix_spawn'):
  blocked.append(event);raise RuntimeError('Forbidden operation: '+event)
 if event=='open':
  mode=args[1];flags=args[2]
  if (isinstance(mode,str) and any(c in mode for c in 'wax+')) or (isinstance(flags,int) and flags & (1|2|64|512|1024)):
   blocked.append(event);raise RuntimeError('Unexpected file write')
sys.addaudithook(audit)
mods={}
for name,item in source['files'].items():
 module=types.ModuleType('baseline_'+name.rsplit('/',1)[-1][:-3]);module.__file__='<Git:'+item['git_blob']+'>'
 exec(compile(item['source'],module.__file__,'exec'),module.__dict__)
 mods[name.rsplit('/',1)[-1]]=module
h=mods['handoff.py'];cli=mods['cli.py']
load_id='SYN-REVIEW-17'
sections=('stops','flags','fines','settlements','exceptions','packets')
def canonical(value):
 return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode()
packet_a=b'<!doctype html><title>Draft SYN-REVIEW-17</title><p>Stop departure: 2026-10-01 12:30</p>'
packet_b=b'<!doctype html><title>Draft SYN-REVIEW-17</title><p>Stop departure: 2026-10-01 14:00</p>'
def evidence(packet,departure):
 data={'schema':'freight-review.v1','packet_sha256':hashlib.sha256(packet).hexdigest(),**{s:[] for s in sections}}
 data['stops']=[{'load_id':load_id,'stop':'Warehouse Δ <North>','departure':departure,'evidence':['tracking.csv:row7']}]
 data['packets']=[{'load_id':load_id,'file':'packets/SYN-REVIEW-17.html','customer':'Authored carrier <not real>'}]
 return data
before=evidence(packet_a,'2026-10-01T12:30:00-05:00')
after=evidence(packet_b,'2026-10-01T14:00:00-05:00')
before_version=hashlib.sha256(canonical(before)).hexdigest()
after_version=hashlib.sha256(canonical(after)).hexdigest()
review_a={'decision':'approve','note':'Verified authored tracking row7; Ω <literal>.','at':'2026-10-02T09:00:00Z','evidence_version':before_version,'history':[],'review_state':'current'}
review_b=copy.deepcopy(review_a);review_b['review_state']='stale'
cases={}
for name,packet,e,review,version in [('before',packet_a,before,review_a,before_version),('same',packet_a,before,review_a,before_version),('after',packet_b,after,review_b,after_version)]:
 raw=h.build_bundle(load_id,packet,e,review,version,h.review_version(review))
 with zipfile.ZipFile(io.BytesIO(raw)) as z:
  members={n:z.read(n) for n in z.namelist()}
 if set(members)!={'index.html','packet.html','evidence.json','review.json','manifest.json'}: raise RuntimeError('Unexpected native inventory')
 manifest=json.loads(members['manifest.json'])
 for f in manifest['files']:
  b=members[f['path']]
  if len(b)!=f['bytes'] or hashlib.sha256(b).hexdigest()!=f['sha256']: raise RuntimeError('Native manifest failed')
 if json.loads(members['evidence.json'])!=e: raise RuntimeError('Evidence changed')
 if json.loads(members['review.json'])['review']!=review: raise RuntimeError('Review changed')
 cases[name]={'bundle':pin(raw),'zip_base64':base64.b64encode(raw).decode(),'members':{n:pin(b) for n,b in members.items()},'evidence':e,'review':review,'cover':members['index.html'].decode()}
if cases['before']['bundle']!=cases['same']['bundle']: raise RuntimeError('Same-copy control changed')
if cases['before']['bundle']==cases['after']['bundle']: raise RuntimeError('Changed source not represented')
out=io.StringIO();err=io.StringIO()
with contextlib.redirect_stdout(out),contextlib.redirect_stderr(err):
 try:
  rc=cli.main(['compare-reviews','before.zip','after.zip','--out','comparison.html'])
 except SystemExit as exc:
  rc=exc.code
if rc!=2 or 'invalid choice' not in err.getvalue(): raise RuntimeError('Missing-command witness changed')
if 'Current saved review: Approve' not in cases['before']['cover'] or 'Previous review' not in cases['after']['cover']: raise RuntimeError('Native review semantics changed')
if 'tracking.csv:row7' in cases['before']['cover'] or 'tracking.csv:row7' in cases['after']['cover']: raise RuntimeError('Source-row display assumption changed')
compact={name:{k:v for k,v in c.items() if k!='cover'} for name,c in cases.items()}
print(json.dumps({'status':'existing-data omission reproduced','source':{'parent':source['parent'],'files':{n:pin(v['source'].encode()) for n,v in source['files'].items()}},'calls':{'native_build_bundle':3,'existing_cli_main':1},'cases':compact,'missing_command':{'exit_code':rc,'stdout':out.getvalue(),'stderr':err.getvalue()},'facts':{'same_copy_byte_identical':True,'all_three_manifest_checks_pass':True,'same_load':True,'evidence_record_counts_equal':{s:len(before[s])==len(after[s]) for s in sections},'changed_packet_and_departure_reference_preserved':True,'old_approval_remains_stale_in_later_copy':True,'native_cover_does_not_show_source_row_or_two_copy_delta':True},'blocked_attempts':blocked,'limits':['Native build_bundle and CLI parser executed from exact in-memory Git source; no complete package filesystem or server process was run.','All snapshots are authored examples. No pipeline/rule accuracy, real charges or current live review is inferred.','No candidate source or comparison behavior is implemented.']},ensure_ascii=False,indent=2))
