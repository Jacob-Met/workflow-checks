+function allocationAuthKey(row) {
+  return JSON.stringify([row.auth_patient_id, row.auth_payer_id, row.auth_no,
+    row.auth_start, row.auth_end, row.auth_evidence]);
+}
+function allocationCell(primary, detail) {
+  return "<td>" + esc(primary) + (detail === undefined ? "" : "<br><small>" + esc(detail) + "</small>") + "</td>";
+}
+function renderAllocationReview() {
+  if (!S) return;
+  const review = S.allocation_review, available = Array.isArray(review);
+  ["#alloc-status", "#alloc-auth", "#alloc-clinic", "#alloc-search"].forEach(id => $(id).disabled = !available);
+  $("#alloc-rows").innerHTML = "";
+  $("#alloc-export").innerHTML = "";
+  if (!available) {
+    $("#alloc-note").textContent = "Allocation details are unavailable in this saved report. Run the worklist to build them.";
+    $("#alloc-count").textContent = "";
+    return;
+  }
+  $("#alloc-note").textContent = S.allocation_review_note || "The existing ledger's assigned visits, with their recorded source rows.";
+  const auths = new Map();
+  for (const row of review) {
+    const key = allocationAuthKey(row);
+    if (!auths.has(key)) auths.set(key, row);
+  }
+  const authSelect = $("#alloc-auth"), priorAuth = authSelect.value;
+  authSelect.innerHTML = '<option value="">All allocated authorization periods</option>' + [...auths].map(([key, row]) => {
+    const label = [row.auth_no, row.auth_patient_id, row.auth_payer_id,
+      row.auth_start + " to " + row.auth_end, row.auth_evidence || "Source unrecorded"].join(" · ");
+    return '<option value="' + esc(key) + '">' + esc(label) + "</option>";
+  }).join("");
+  authSelect.value = auths.has(priorAuth) ? priorAuth : "";
+  const clinics = [...new Set(review.map(row => row.clinic))].sort();
+  const clinicSelect = $("#alloc-clinic"), priorClinic = clinicSelect.value;
+  clinicSelect.innerHTML = '<option value="">All visit clinics</option>' + clinics.map(name =>
+    '<option value="' + esc(JSON.stringify(name)) + '">' + esc(name || "Unrecorded visit clinic") + "</option>").join("");
+  clinicSelect.value = clinics.some(name => JSON.stringify(name) === priorClinic) ? priorClinic : "";
+  const bucket = $("#alloc-status").value, auth = authSelect.value, clinic = clinicSelect.value;
+  const query = $("#alloc-search").value.toLowerCase();
+  const rows = review.filter(row => (!bucket || row.allocation === bucket)
+    && (!auth || allocationAuthKey(row) === auth)
+    && (!clinic || JSON.stringify(row.clinic) === clinic)
+    && (!query || Object.values(row).some(value => String(value).toLowerCase().includes(query))));
+  const used = review.filter(row => row.allocation === "used").length;
+  const reserved = review.filter(row => row.allocation === "scheduled").length;
+  $("#alloc-count").textContent = rows.length + " of " + review.length + " allocated visits shown · "
+    + used + " used / " + reserved + " reserved in the complete report · as of "
+    + S.as_of + " · clinic time zone: " + (S.clinic_timezone || "unrecorded");
+  if (rows.length) {
+    const headers = ["Visit / type", "Date", "Allocation / recorded status", "Patient",
+      "Visit clinic / therapist", "Payer", "Authorization period", "Source rows"];
+    $("#alloc-rows").innerHTML = '<div class="review-table" tabindex="0" role="region" aria-label="Allocated visits"><table><thead><tr>'
+      + headers.map(label => '<th scope="col">' + label + "</th>").join("") + "</tr></thead><tbody>"
+      + rows.map(row => {
+        const allocation = row.allocation === "used" ? "Used" : row.allocation === "scheduled" ? "Reserved" : row.allocation;
+        return '<tr data-visit-id="' + esc(row.visit_id) + '" data-authorization="' + esc(allocationAuthKey(row)) + '">'
+          + allocationCell(row.visit_id, row.visit_type)
+          + allocationCell(row.visit_date)
+          + allocationCell(allocation, "Recorded " + row.status)
+          + allocationCell(row.patient_name || "Name unavailable", row.patient_id)
+          + allocationCell(row.clinic || "Unrecorded", row.therapist || "Therapist unrecorded")
+          + allocationCell(row.payer_name || "Name unavailable", row.payer_id)
+          + allocationCell(row.auth_no, row.auth_start + " to " + row.auth_end + "; "
+            + row.auth_visits_authorized + " authorized; patient " + row.auth_patient_id + "; payer " + row.auth_payer_id)
+          + allocationCell("Visit: " + (row.visit_evidence || "Unrecorded"),
+            "Authorization: " + (row.auth_evidence || "Unrecorded")) + "</tr>";
+      }).join("") + "</tbody></table></div>";
+  } else {
+    $("#alloc-rows").innerHTML = review.length ? "<p>No allocated visits match these filters.</p>" : "<p>No visits were allocated in this report.</p>";
+  }
+  $("#alloc-export").innerHTML = '<a href="/out/allocated_visits.csv" download>Download all allocated visits CSV</a> · '
+    + '<a href="/out/digest.html" target="_blank" rel="noopener">Open complete printable digest</a><br>'
+    + "<small>Both include all allocated visits, independent of these filters.</small>";
+}
+["#alloc-status", "#alloc-auth", "#alloc-clinic"].forEach(id => $(id).onchange = renderAllocationReview);
